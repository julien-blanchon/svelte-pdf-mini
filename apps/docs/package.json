{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run api && vite dev",
		"build": "bun run api && vite build",
		"preview": "vite preview",
		"api": "bun scripts/generate-api.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"test:e2e": "playwright test --grep @smoke",
		"test:e2e:full": "playwright test"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.139",
		"@iconify/tailwind4": "^1.2.3",
		"@melt-ui/svelte": "^0.86.6",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.4",
		"@types/unist": "^3.0.3",
		"bits-ui": "^2.19.5",
		"github-slugger": "^2.0.0",
		"mdsvex": "^0.12.8",
		"rehype-pretty-code": "^0.14.5",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7",
		"svelte-pdf-mini": "workspace:*",
		"tailwindcss": "^4.3",
		"typescript": "^7.0.2",
		"vite": "^8.3",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
